{
  "display": {
    "mode": "index",
    "index": 1,
    "match": {
      "width": 1920,
      "height": 540,
      "tolerance": 80
    },
    "bounds": {
      "x": 1707,
      "y": 0,
      "width": 1920,
      "height": 550
    }
  },
  "window": {
    "alwaysOnTop": false,
    "autoHideCursorMs": 5000
  },
  "metrics": {
    "pollMs": 1500,
    "historySize": 90,
    "slowPollMs": 3000
  },
  "clipboard": {
    "enabled": true,
    "maxItems": 30,
    "pollMs": 800
  },
  "theme": {
    "accent": "#57b6ff"
  },
  "dockCategories": [
    {
      "name": "浏览器",
      "icon": "🌐"
    },
    {
      "name": "系统",
      "icon": "⚙️"
    },
    {
      "name": "开发",
      "icon": "💻"
    },
    {
      "name": "工具",
      "icon": "🛠️"
    }
  ],
  "dock": [
    {
      "name": "Edge",
      "icon": "🌐",
      "category": "浏览器",
      "type": "path",
      "target": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "order": 1
    },
    {
      "name": "资源管理器",
      "icon": "📁",
      "category": "系统",
      "type": "path",
      "target": "C:\\Windows\\explorer.exe",
      "order": 2
    },
    {
      "name": "toolbar 项目",
      "icon": "🧩",
      "category": "开发",
      "type": "path",
      "target": "D:\\GitProject\\toolbar",
      "order": 3
    },
    {
      "name": "任务管理器",
      "icon": "📊",
      "category": "系统",
      "type": "cmd",
      "target": "taskmgr",
      "order": 4
    },
    {
      "name": "记事本",
      "icon": "📝",
      "category": "工具",
      "type": "path",
      "target": "C:\\Windows\\System32\\notepad.exe",
      "order": 5
    },
    {
      "name": "Windows 设置",
      "icon": "⚙️",
      "category": "系统",
      "type": "url",
      "target": "ms-settings:",
      "order": 6
    },
    {
      "name": "显示设置",
      "icon": "🖥️",
      "category": "系统",
      "type": "url",
      "target": "ms-settings:display",
      "order": 7
    }
  ],
  "music": {
    "folder": "D:\\GitProject\\toolbar\\samples\\demo",
    "recursive": true,
    "volume": 0.7,
    "repeat": "all"
  },
  "ai": {
    "model": "deepseek-chat",
    "systemPrompt": "你是常驻在桌面工具栏里的助手，回答尽量简短。",
    "temperature": 0.6,
    "maxTokens": 1024,
    "contextMessages": 12,
    "timeoutMs": 60000,
    "firstByteTimeoutMs": 15000,
    "persistHistory": true,
    "name": "小肥鱼",
    "persona": "video",
    "emotion": true,
    "motion": "full",
    "agentTools": {
      "enabled": true
    }
  },
  "voice": {
    "enabled": true,
    "ttsEngine": "auto",
    "ttsVoice": "zh-CN-XiaoyiNeural",
    "ttsPitch": "+3Hz",
    "ttsSpeed": 1,
    "ttsSid": 3,
    "autoSpeak": true,
    "autoSend": true
  },
  "dsh": {
    "enabled": true,
    "workspace": "dsh-workspace",
    "port": 3080,
    "startupTimeoutMs": 120000,
    "telemetry": false
  },
  "search": {
    "enabled": true,
    "maxResults": 20,
    "minChars": 2,
    "timeoutMs": 1500,
    "autoStart": true,
    "sort": "NAME_ASCENDING"
  }
}
