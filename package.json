{
  "name": "screen-toolbar",
  "version": "0.1.0",
  "description": "Full-screen toolbar for a dedicated 1920x540 display",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "displays": "electron ./tools/print-displays.js",
    "diag": "electron ./tools/diagnose.js",
    "test:ai": "node ./tools/ai-mock-test.js",
    "dsh:check": "node ./tools/dsh-check.js",
    "dpi:measure": "electron ./tools/dpi-bounds-measure.js",
    "voice:install": "node ./tools/install-voice.js",
    "voice:selftest": "electron ./tools/voice-selftest.js",
    "voice:tryout": "electron ./tools/voice-tryout.js",
    "package": "node ./tools/package.js",
    "demo": "node tools/make-demo-audio.js",
    "everything:check": "node ./tools/everything-check.js",
    "search:appprobe": "node ./tools/search-appprobe.js",
    "agent:appprobe": "node ./tools/agent-appprobe.js",
    "ai:appprobe": "node ./tools/ai-appprobe.js",
    "layout:appprobe": "node ./tools/layout-appprobe.js",
    "desktop:appprobe": "node ./tools/desktop-appprobe.js",
    "layout:check": "node ./tools/layout-check.js",
    "trainers:check": "node ./tools/trainers-check.js",
    "trainers:appprobe": "node ./tools/trainers-appprobe.js",
    "steam:check": "node ./tools/steam-check.js",
    "steam:appprobe": "node ./tools/steam-appprobe.js",
    "games:check": "node ./tools/games-check.js",
    "games:appprobe": "node ./tools/games-appprobe.js",
    "mail:check": "node ./tools/mail-check.js",
    "mail:appprobe": "node ./tools/mail-appprobe.js",
    "video:check": "node ./tools/video-check.js",
    "video:appprobe": "node ./tools/video-appprobe.js",
    "photos:check": "node ./tools/photos-check.js",
    "photos:appprobe": "node ./tools/photos-appprobe.js",
    "bili:check": "node ./tools/bili-check.js",
    "bili:appprobe": "node ./tools/bili-appprobe.js",
    "projects:check": "node ./tools/projects-check.js",
    "projects:appprobe": "node ./tools/projects-appprobe.js",
    "git:check": "node ./tools/git-check.js",
    "git:appprobe": "node ./tools/git-appprobe.js",
    "office:check": "node ./tools/office-check.js",
    "office:appprobe": "node ./tools/office-appprobe.js",
    "clipboard:appprobe": "node ./tools/clipboard-appprobe.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.2",
    "imapflow": "^2.10.2",
    "koffi": "^3.3.6",
    "node-edge-tts": "^1.2.12",
    "sherpa-onnx-node": "^2.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.3.1"
  },
  "private": true
}
