{
  "name": "screen-toolbar",
  "version": "0.1.0",
  "description": "Full-screen toolbar for a dedicated 1920x540 display",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "displays": "electron ./tools/print-displays.js",
    "diag": "electron ./tools/diagnose.js",
    "test:ai": "node ./tools/ai-mock-test.js",
    "dsh:check": "node ./tools/dsh-check.js",
    "dpi:measure": "electron ./tools/dpi-bounds-measure.js",
    "voice:install": "node ./tools/install-voice.js",
    "voice:selftest": "electron ./tools/voice-selftest.js",
    "voice:tryout": "electron ./tools/voice-tryout.js",
    "package": "node ./tools/package.js",
    "demo": "node tools/make-demo-audio.js",
    "everything:check": "node ./tools/everything-check.js",
    "search:appprobe": "node ./tools/search-appprobe.js",
    "layout:appprobe": "node ./tools/layout-appprobe.js"
  },
  "dependencies": {
    "node-edge-tts": "^1.2.12",
    "sherpa-onnx-node": "^2.0.1",
    "@deepseek-ai/dsh": "^0.2.1-rc.2",
    "koffi": "^3.1.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.3.1"
  },
  "private": true
}
